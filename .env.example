# MongoDB Atlas (Database > Connect > Drivers > copy the connection string)
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=agripulse

GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

RAZORPAY_KEY_ID=<YOUR_RAZORPAY_TEST_KEY_ID>
RAZORPAY_KEY_SECRET=<YOUR_RAZORPAY_TEST_KEY_SECRET>

AGMARKNET_API_KEY=<YOUR_DATA_GOV_IN_API_KEY>

WEATHER_API_KEY=<YOUR_WEATHER_API_KEY>

# Auth (long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=<RANDOM_SECRET>

# Razorpay webhook secret (set the same value in the Razorpay dashboard webhook)
RAZORPAY_WEBHOOK_SECRET=<YOUR_WEBHOOK_SECRET>

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5555,http://127.0.0.1:5555

# Disease prediction: below this confidence the result is "Uncertain"
CONFIDENCE_THRESHOLD=90

# WhatsApp bot (Twilio) - see docs/WHATSAPP_BOT.md
TWILIO_ACCOUNT_SID=<YOUR_TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<YOUR_TWILIO_AUTH_TOKEN>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Requests are checked against Twilio's signature whenever the token above is set.
# Set to false only to test the webhook locally with curl.
# TWILIO_VALIDATE_SIGNATURE=true
# Link shown to farmers who need to register in the web app
FRONTEND_URL=http://localhost:5555
# Hour (server time) of the daily morning message
DIGEST_HOUR=7

# Disease model: yolo (YOLOv8-cls, falls back to EfficientNet) or efficientnet
DISEASE_MODEL=yolo
# Optional path of the YOLOv8 weights (default app/ai/models/yolov8_disease.pt)
YOLO_MODEL_PATH=app/ai/models/yolov8_disease.pt

# Razorpay checkout: true = show only UPI
RAZORPAY_UPI_ONLY=false

# Sarvam AI (https://dashboard.sarvam.ai) - translation, speech-to-text, text-to-speech
SARVAM_API_KEY=<YOUR_SARVAM_API_KEY>
# Optional overrides (defaults work): SARVAM_TRANSLATE_MODEL, SARVAM_STT_MODEL,
# SARVAM_TTS_MODEL, SARVAM_TTS_SPEAKER

# Public https URL of this server (ngrok) - needed for WhatsApp voice replies
PUBLIC_BASE_URL=https://<YOUR-NGROK-SUBDOMAIN>.ngrok-free.app

# Land records / Soil Health Card: mock (demo data) or real (needs DigiLocker partner access)
DIGILOCKER_PROVIDER=mock
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# Demo phone login: OTP is always 123456. Set to false to switch it off (needs a real SMS OTP provider)
FAKE_AUTH=true
